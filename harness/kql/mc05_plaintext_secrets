// CIS v5.0.0 - 9.x (App Service: app should reference Key Vault, not inline secrets)
// LIMITATION: ARG does not expose app-setting VALUES, so KQL cannot see "Password=".
// Honest fallback (OUT of ARG) - inspect the value directly, then adjudicate by hand:
az webapp config appsettings list -g rg-vuln05 -n <app> \
  --query "[?name=='SQL_CONNECTION'].value" -o tsv
//   Key Vault reference -> @Microsoft.KeyVault(SecretUri=...)
//   plaintext secret    -> contains "Password="

